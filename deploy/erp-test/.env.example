# Copy to .env (git-ignored) and fill in.

# The exact image the LIVE backend container runs (from: docker inspect ... on the server).
ERP_IMAGE=registry/erp-custom:15

# Same MariaDB major/minor version as the LIVE db container (from: mariadb --version on the server).
MARIADB_IMAGE=mariadb:10.6

# Root password for the LOCAL test database only (not the live one).
DB_ROOT_PASSWORD=change-me-local-only

# Local site name; http://localhost:8080 serves this site.
SITE_NAME=erp-test.local

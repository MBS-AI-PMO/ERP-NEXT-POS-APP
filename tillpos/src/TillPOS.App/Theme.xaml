<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:TillPOS.App">
  <!-- TillPOS look. Built for slow tills: solid colours only (no gradients, effects, shadows or animations), simple
       templates, icons from the built-in Windows icon font (one text glyph each, nothing to load). -->

  <!-- ===== Colours ===== -->
  <SolidColorBrush x:Key="Ink" Color="#15191E" />
  <SolidColorBrush x:Key="InkRaised" Color="#262C33" />      <!-- pills and chips on dark bars and cards -->
  <SolidColorBrush x:Key="OnInkMuted" Color="#AEB6BF" />     <!-- secondary text on Ink -->
  <SolidColorBrush x:Key="Ground" Color="#EDF0EC" />
  <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Hover" Color="#F3F5F2" />
  <SolidColorBrush x:Key="Subtle" Color="#E4E8E2" />         <!-- secondary buttons, disabled fills -->
  <SolidColorBrush x:Key="Accent" Color="#0F6B4B" />
  <SolidColorBrush x:Key="AccentSoft" Color="#E2F1E9" />     <!-- selected rows, highlights -->
  <SolidColorBrush x:Key="AccentLine" Color="#9CCBB6" />
  <SolidColorBrush x:Key="Warn" Color="#8A4205" />
  <SolidColorBrush x:Key="WarnSoft" Color="#FCF0E3" />
  <SolidColorBrush x:Key="Danger" Color="#A3261B" />
  <SolidColorBrush x:Key="DangerSoft" Color="#FBECEA" />
  <SolidColorBrush x:Key="DangerLine" Color="#E8C3BE" />
  <SolidColorBrush x:Key="Muted" Color="#5B6470" />
  <SolidColorBrush x:Key="HintText" Color="#8B939D" />       <!-- placeholders -->
  <SolidColorBrush x:Key="Line" Color="#D3D8D0" />
  <SolidColorBrush x:Key="LineStrong" Color="#B4BBB2" />     <!-- input borders -->
  <SolidColorBrush x:Key="Online" Color="#3CCB7F" />
  <SolidColorBrush x:Key="Offline" Color="#F5A524" />
  <SolidColorBrush x:Key="HoverOverlay" Color="#0B000000" /> <!-- laid over any button colour -->
  <SolidColorBrush x:Key="PressedOverlay" Color="#24000000" />

  <!-- ===== Type ===== -->
  <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="CodeFont">Consolas</FontFamily>

  <!-- ===== Shape and spacing ===== -->
  <CornerRadius x:Key="Radius">8</CornerRadius>
  <CornerRadius x:Key="CardRadius">10</CornerRadius>
  <Thickness x:Key="CardPadding">20,16</Thickness>

  <!-- A banknote, for cash (no glyph for it exists in both icon fonts). Stroke it; 20 x 14. -->
  <Geometry x:Key="CashGeometry">M1.5,1.5 H18.5 V12.5 H1.5 Z M10,4.5 A2.5,2.5 0 1 1 9.99,4.5 M4.5,7 H5 M15,7 H15.5</Geometry>

  <!-- ===== Converters ===== -->
  <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  <local:CountToVisibilityConverter x:Key="CountToVisibility" />
  <local:CountToVisibilityConverter x:Key="EmptyToVisibility" Invert="True" />
  <local:EqualConverter x:Key="Equal" />

  <!-- ===== Text ===== -->
  <Style TargetType="TextBlock" x:Key="Money">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>
  <Style TargetType="TextBlock" x:Key="ScreenTitle">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
  </Style>
  <!-- Small heading above a group or a column ("Recent bills", "Reason"). -->
  <Style TargetType="TextBlock" x:Key="SectionTitle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
  </Style>
  <!-- A glyph from the icon font. -->
  <Style TargetType="TextBlock" x:Key="Icon">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- White card on the ground colour. -->
  <Style TargetType="Border" x:Key="Card">
    <Setter Property="Background" Value="{StaticResource Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
    <Setter Property="Padding" Value="{StaticResource CardPadding}" />
  </Style>
  <!-- Dark card for the big amount (amount due, total counted, refund). -->
  <Style TargetType="Border" x:Key="InkCard">
    <Setter Property="Background" Value="{StaticResource Ink}" />
    <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
    <Setter Property="Padding" Value="{StaticResource CardPadding}" />
  </Style>

  <!-- ===== Buttons =====
       One flat template: rounded border, optional leading icon (local:ButtonIcon.Glyph), and a see-through overlay that
       darkens on hover and press, so the same template works for every button colour. -->
  <ControlTemplate x:Key="ButtonTemplate" TargetType="ButtonBase">
    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius}" SnapsToDevicePixels="True">
      <Border x:Name="Overlay" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
        <DockPanel x:Name="Body" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
          <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Text="{TemplateBinding local:ButtonIcon.Glyph}" FontFamily="{StaticResource IconFont}"
                     FontSize="{TemplateBinding local:ButtonIcon.Size}" FontWeight="Normal" VerticalAlignment="Center" Margin="0,0,10,0" />
          <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center" SnapsToDevicePixels="True" />
        </DockPanel>
      </Border>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="local:ButtonIcon.Glyph" Value="{x:Null}">
        <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Overlay" Property="Background" Value="{StaticResource HoverOverlay}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Overlay" Property="Background" Value="{StaticResource PressedOverlay}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Subtle}" />
        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Subtle}" />
        <Setter TargetName="Body" Property="TextElement.Foreground" Value="#9AA19A" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- Standard till key: white, outlined; keypads and most actions. -->
  <Style TargetType="Button" x:Key="KeyButton">
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="MinWidth" Value="56" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Background" Value="{StaticResource Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template" Value="{StaticResource ButtonTemplate}" />
  </Style>
  <!-- The main action of a screen (pay, complete, confirm). -->
  <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource KeyButton}">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="local:ButtonIcon.Size" Value="22" />
  </Style>
  <!-- Destroys something (void, delete). -->
  <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource KeyButton}">
    <Setter Property="Foreground" Value="{StaticResource Danger}" />
    <Setter Property="BorderBrush" Value="{StaticResource DangerLine}" />
  </Style>
  <!-- Less important actions (log out, reprint): soft grey fill, no outline. -->
  <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource KeyButton}">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Background" Value="{StaticResource Subtle}" />
    <Setter Property="BorderBrush" Value="{StaticResource Subtle}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="local:ButtonIcon.Size" Value="16" />
  </Style>
  <!-- Flat until touched: list rows (search results), minor links. -->
  <Style TargetType="Button" x:Key="GhostButton" BasedOn="{StaticResource KeyButton}">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="local:ButtonIcon.Size" Value="16" />
  </Style>
  <!-- Icon-only button (−, +, ✕ on a line). Content is a glyph from the icon font. -->
  <Style TargetType="Button" x:Key="IconButton" BasedOn="{StaticResource KeyButton}">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style TargetType="Button" x:Key="DangerIconButton" BasedOn="{StaticResource IconButton}">
    <Setter Property="Foreground" Value="{StaticResource Danger}" />
    <Setter Property="BorderBrush" Value="{StaticResource DangerLine}" />
  </Style>

  <!-- ===== Text boxes =====
       Rounded, padded, Accent border while typing in it. local:Placeholder.Icon draws a leading icon; local:Placeholder.Text
       shows muted hint text while the box is empty. The text box applies its own Padding inside PART_ContentHost, so the
       template only uses it to line the hint up with the typed text. -->
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource Panel}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
    <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius}" SnapsToDevicePixels="True">
            <Border x:Name="Ring" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="Glyph" Text="{TemplateBinding local:Placeholder.Icon}" FontFamily="{StaticResource IconFont}"
                           FontSize="{TemplateBinding local:Placeholder.IconSize}" FontWeight="Normal" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBlock x:Name="Hint" Grid.Column="1" Text="{TemplateBinding local:Placeholder.Text}" FontFamily="{StaticResource TextFont}"
                           FontSize="{TemplateBinding local:Placeholder.FontSize}" FontWeight="Normal" Foreground="{StaticResource HintText}"
                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextAlignment="{TemplateBinding TextAlignment}"
                           TextTrimming="CharacterEllipsis" Margin="{TemplateBinding Padding}" Padding="2,0" IsHitTestVisible="False"
                           Visibility="Collapsed" />
                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Focusable="False" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Grid>
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="local:Placeholder.Icon" Value="{x:Null}">
              <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Muted}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
              <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Accent}" />
              <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ground}" />
              <Setter Property="Foreground" Value="{StaticResource Muted}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- The box the scanner and keyboard type codes into: green outline even before it has the keyboard. -->
  <Style TargetType="TextBox" x:Key="ScanTextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Height" Value="56" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    <Setter Property="local:Placeholder.Icon" Value="&#xEE6F;" />
    <Setter Property="local:Placeholder.IconSize" Value="24" />
    <Setter Property="local:Placeholder.FontSize" Value="17" />
  </Style>
  <!-- Search by name: magnifier in front. -->
  <Style TargetType="TextBox" x:Key="SearchTextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Height" Value="44" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="local:Placeholder.Icon" Value="&#xE721;" />
    <Setter Property="local:Placeholder.IconSize" Value="16" />
    <Setter Property="local:Placeholder.FontSize" Value="15" />
  </Style>
  <!-- Money typed on the keypad. -->
  <Style TargetType="TextBox" x:Key="AmountTextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>

  <Style TargetType="PasswordBox">
    <Setter Property="Background" Value="{StaticResource Panel}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius}" SnapsToDevicePixels="True">
            <Border x:Name="Ring" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7">
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
              <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Lists =====
       Rounded white panel; rows get a soft hover and a green selected state. The items panel stays the default
       VirtualizingStackPanel, and the ScrollViewer scrolls by item, so long bills stay virtualized. -->
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{StaticResource Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource CardRadius}" SnapsToDevicePixels="True">
            <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False">
              <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="{StaticResource Radius}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" SnapsToDevicePixels="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentLine}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Separator">
    <Setter Property="Margin" Value="0,8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Background="{StaticResource Line}" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>

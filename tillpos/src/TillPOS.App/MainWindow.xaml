<Window x:Class="TillPOS.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TillPOS.Presentation;assembly=TillPOS.Presentation"
        xmlns:views="clr-namespace:TillPOS.App.Views"
        Title="TillPOS" Width="1366" Height="768" WindowState="Maximized"
        Background="{StaticResource Ground}" FontFamily="{StaticResource TextFont}" FontSize="15">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:StatusViewModel}"><views:StatusView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DownloadViewModel}"><views:DownloadView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:LoginViewModel}"><views:LoginView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:OpenShiftViewModel}"><views:OpenShiftView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SaleViewModel}"><views:SaleView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PaymentViewModel}"><views:PaymentView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:CloseShiftViewModel}"><views:CloseShiftView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ReturnViewModel}"><views:ReturnView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:UploadProblemsViewModel}"><views:UploadProblemsView /></DataTemplate>
  </Window.Resources>
  <DockPanel>
    <!-- Header: shop and till on the left; cashier, sync state and clock on the right. -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Ink}" Height="56" Padding="20,0">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{StaticResource Accent}" CornerRadius="8" Width="34" Height="34" Margin="0,0,12,0">
            <TextBlock Text="&#xEC59;" Style="{StaticResource Icon}" Foreground="White" HorizontalAlignment="Center" />
          </Border>
          <TextBlock Text="{Binding ShopName}" Foreground="White" FontWeight="Bold" FontSize="17" VerticalAlignment="Center" />
          <Border Background="{StaticResource InkRaised}" CornerRadius="6" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
            <!-- "Till 2 · Counter 1" while a shift is open. -->
            <TextBlock Text="{Binding TillHeader}" Foreground="{StaticResource OnInkMuted}" FontSize="14" />
          </Border>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <!-- A Dev build (uploads go to the dev ERPNext, data in C:\ProgramData\TillPOS-Dev): purple "DEV". -->
          <Border CornerRadius="6" Padding="10,3" Margin="0,0,8,0" VerticalAlignment="Center" Background="#6D4AFF"
                  Visibility="{Binding IsDev, Converter={StaticResource BoolToVisibility}}"
                  ToolTip="Dev build: test documents go to the DEV ERPNext (dev.quickgroc.com), not production.">
            <TextBlock Text="DEV" Foreground="White" FontWeight="Bold" FontSize="14" />
          </Border>
          <!-- Upload mode: red "LIVE UPLOAD" while bills are written to ERPNext, amber "DRY RUN" while they are only previewed. -->
          <Border CornerRadius="6" Padding="10,3" Margin="0,0,20,0" VerticalAlignment="Center">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Upload}" Value="Live">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Background" Value="{StaticResource Danger}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Upload}" Value="DryRun">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Background" Value="{StaticResource Offline}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock Text="{Binding UploadBadge}" FontWeight="Bold" FontSize="14">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="White" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Upload}" Value="DryRun"><Setter Property="Foreground" Value="{StaticResource Ink}" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Border>
          <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource OnInkMuted}" Margin="0,0,8,0" />
          <TextBlock Foreground="White" VerticalAlignment="Center" Margin="0,0,20,0">
            <Run Text="Cashier " Foreground="{StaticResource OnInkMuted}" /><Run Text="{Binding Session.Cashier.Name, Mode=OneWay}" FontWeight="SemiBold" />
          </TextBlock>
          <!-- The sync pill: click it on any screen for the Sync status window (read-only, no PIN). Not focusable, so a scan's
               Enter never presses it. -->
          <Button Command="{Binding SyncStatusCommand}" Focusable="False" Cursor="Hand" Margin="0,0,20,0"
                  ToolTip="Sync status: downloads, uploads today, waiting and failed">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Pill" CornerRadius="14" Background="{StaticResource InkRaised}" Padding="12,5">
                  <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Opacity" Value="0.85" /></Trigger>
                  <Trigger Property="IsPressed" Value="True"><Setter TargetName="Pill" Property="Opacity" Value="0.7" /></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE753;" FontSize="16" Margin="0,0,8,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                    <Setter Property="Foreground" Value="{StaticResource Offline}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Online}" Value="True"><Setter Property="Foreground" Value="{StaticResource Online}" /></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Text="{Binding SyncStatus}" Foreground="White" VerticalAlignment="Center" ToolTip="{Binding SyncNotes}" />
              <!-- "N uploaded today · N waiting · M failed"; the tooltip lists what the last upload run reported. -->
              <TextBlock Foreground="{StaticResource OnInkMuted}" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="{Binding UploadProblemsText}">
                <Run Text="· " /><Run Text="{Binding UploadCountsText, Mode=OneWay}" />
              </TextBlock>
            </StackPanel>
          </Button>
          <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource OnInkMuted}" Margin="0,0,8,0" />
          <TextBlock Text="{Binding Clock}" Foreground="White" FontSize="17" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                     VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>
    <!-- Not a tab stop: the keyboard belongs to the boxes of the screen shown, never to this host. -->
    <ContentControl Content="{Binding Current}" Margin="16" Focusable="False" IsTabStop="False" />
  </DockPanel>
</Window>

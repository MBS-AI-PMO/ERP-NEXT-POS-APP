<UserControl x:Class="TillPOS.App.Views.CloseShiftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TillPOS.App"
             Focusable="True" FocusVisualStyle="{x:Null}">
  <UserControl.Resources>
    <Style TargetType="TextBox" x:Key="CountBox" BasedOn="{StaticResource AmountTextBox}">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Height" Value="38" />
      <Setter Property="local:Placeholder.FontSize" Value="14" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="local:Keyboarding.SelectAllOnTap" Value="True" />
    </Style>
    <Style TargetType="TextBlock" x:Key="MessageText">
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MinHeight" Value="22" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding MessageIsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource Danger}" /></DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <!-- Scrolls only when the screen is too small (e.g. 125% scaling), so the buttons stay reachable. -->
  <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid>
      <!-- ===== Blind count. Nothing here shows (or depends on) the expected amounts; they are only on the Z report. ===== -->
      <Grid x:Name="CountStage" MaxWidth="1000" KeyboardNavigation.TabNavigation="Cycle" KeyDown="CountStageKeyDown">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="380" /></Grid.ColumnDefinitions>
  
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Accent}" Margin="0,0,10,0" />
            <TextBlock Text="Close shift — count the drawer" Style="{StaticResource ScreenTitle}" />
          </StackPanel>
          <TextBlock Text="Enter how many of each note and coin (Enter moves to the next box) and the card machine total. Closing needs a supervisor PIN; the shift (Z) report then prints."
                     Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
          <!-- Bills of this shift not in ERPNext yet: the Closing Shift waits for them. -->
          <TextBlock Text="{Binding UploadWarning}" Foreground="{StaticResource Warn}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding UploadWarning}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
  
        <!-- Denominations -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="16,8" Margin="0,0,16,0" VerticalAlignment="Top">
          <StackPanel>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Note / coin" Style="{StaticResource SectionTitle}" />
              <TextBlock Grid.Column="1" Text="How many" Style="{StaticResource SectionTitle}" TextAlignment="Right" />
              <TextBlock Grid.Column="2" Text="Amount" Style="{StaticResource SectionTitle}" TextAlignment="Right" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Denominations}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Height="42">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="17">
                      <Run Text="AED " Foreground="{StaticResource Muted}" /><Run Text="{Binding Label, Mode=OneWay}" FontWeight="Bold" />
                    </TextBlock>
                    <TextBox Grid.Column="1" Style="{StaticResource CountBox}" Text="{Binding Count.Text, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" Text="{Binding LineTotal}" FontSize="18" TextAlignment="Right" VerticalAlignment="Center"
                               Style="{StaticResource Money}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
  
        <!-- Totals and actions -->
        <StackPanel Grid.Row="1" Grid.Column="1">
          <Border Style="{StaticResource Card}" Padding="16,12">
            <StackPanel>
              <TextBlock Text="Or the counted cash as one total" FontWeight="SemiBold" />
              <TextBlock Text="When filled, it is used instead of the notes and coins." FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
              <TextBox Style="{StaticResource CountBox}" Margin="0,4,0,0" local:Placeholder.Text="Or type the counted cash total"
                       Text="{Binding UseTotalInstead.Text, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Text="Card machine total (settlement)" FontWeight="SemiBold" Margin="0,12,0,0" />
              <TextBlock Text="Blank counts as 0.00." FontSize="13" Foreground="{StaticResource Muted}" />
              <TextBox Style="{StaticResource CountBox}" Margin="0,4,0,0" local:Placeholder.Text="Card machine total" local:Placeholder.Icon="&#xE8C7;"
                       local:Placeholder.IconSize="15" Text="{Binding CardTotal.Text, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource InkCard}" Padding="16,12" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="COUNTED CASH (AED)" Foreground="{StaticResource OnInkMuted}" FontSize="13" FontWeight="SemiBold" />
              <TextBlock Text="{Binding CashTotal}" Foreground="White" FontSize="40" FontWeight="Bold" Style="{StaticResource Money}" />
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding Message}" Style="{StaticResource MessageText}" Margin="0,8,0,0" />
          <Button Focusable="False" Style="{StaticResource PrimaryButton}" Height="72" Margin="4,8,4,4" local:ButtonIcon.Glyph="&#xE73E;" Content="Close shift &amp; print Z report" Command="{Binding CloseCommand}" />
          <Button Focusable="False" Style="{StaticResource KeyButton}" Height="56" local:ButtonIcon.Glyph="&#xE72B;" Content="Back to the sale (Esc)" Command="{Binding BackCommand}" />
        </StackPanel>
      </Grid>
  
    </Grid>
  </ScrollViewer>
</UserControl>

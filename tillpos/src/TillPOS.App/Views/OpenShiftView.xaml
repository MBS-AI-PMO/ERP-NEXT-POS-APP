<UserControl x:Class="TillPOS.App.Views.OpenShiftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TillPOS.App">
  <UserControl.InputBindings>
    <KeyBinding Key="Enter" Command="{Binding OpenCommand}" />
  </UserControl.InputBindings>
  <UserControl.Resources>
    <Style TargetType="Button" x:Key="PadKey" BasedOn="{StaticResource KeyButton}">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Height" Value="60" />
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- One counter: big, never focusable (the keyboard stays in the cash box). Selected = accent; unavailable = greyed but
         still pressable, so pressing it says why it cannot be chosen. -->
    <Style TargetType="Button" x:Key="CounterButton" BasedOn="{StaticResource KeyButton}">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="MinHeight" Value="68" />
      <Setter Property="Padding" Value="16,6" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="Background" Value="{StaticResource AccentSoft}" />
          <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
          <Setter Property="BorderThickness" Value="2" />
          <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Available}" Value="False">
          <Setter Property="Background" Value="{StaticResource Subtle}" />
          <Setter Property="BorderBrush" Value="{StaticResource Subtle}" />
          <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
    <!-- Step 1: the counter (only when the till has more than one). -->
    <Border Style="{StaticResource Card}" Width="340" Padding="20,22" Margin="0,0,16,0" VerticalAlignment="Stretch"
            Visibility="{Binding ShowCounters, Converter={StaticResource BoolToVisibility}}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Accent}" Margin="0,0,10,0" />
            <TextBlock Text="Your counter" FontSize="24" FontWeight="Bold" />
          </StackPanel>
          <TextBlock Text="Where are you working this shift?" Foreground="{StaticResource Muted}" Margin="0,4,0,12" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" MaxHeight="470">
          <ItemsControl ItemsSource="{Binding Counters}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource CounterButton}" CommandParameter="{Binding}"
                        Command="{Binding DataContext.SelectCounterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="20" VerticalAlignment="Center"
                               Foreground="{StaticResource Accent}"
                               Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Detail}" FontSize="13" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DockPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Step 2: the float, counted for the chosen counter's drawer. -->
    <Border Style="{StaticResource Card}" Width="420" Padding="24,22">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE785;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Accent}" Margin="0,0,10,0" />
          <TextBlock Text="Open shift" FontSize="24" FontWeight="Bold" />
        </StackPanel>
        <TextBlock Foreground="{StaticResource Muted}" Margin="0,4,0,12" TextWrapping="Wrap">
          <Run Text="Count the cash in the drawer and enter it." />
          <Run Text="{Binding SelectedCounter.Name, Mode=OneWay, StringFormat='Counter: {0}'}" FontWeight="SemiBold"
               Foreground="{StaticResource Accent}" />
        </TextBlock>
        <TextBox x:Name="CashBox" Style="{StaticResource AmountTextBox}" Margin="4,0" local:Keyboarding.SelectAllOnTap="True"
                 local:Placeholder.Text="Cash in the drawer, e.g. 200" local:Placeholder.FontSize="17"
                 Text="{Binding OpeningCash.Text, UpdateSourceTrigger=PropertyChanged}" FontSize="28" Height="56" />
        <TextBlock Text="{Binding Message}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" MinHeight="22" Margin="4" />
        <UniformGrid Columns="3">
          <Button Focusable="False" Style="{StaticResource PadKey}" Content="1" Command="{Binding KeyCommand}" CommandParameter="1" />
          <Button Focusable="False" Style="{StaticResource PadKey}" Content="2" Command="{Binding KeyCommand}" CommandParameter="2" />
          <Button Focusable="False" Style="{StaticResource PadKey}" Content="3" Command="{Binding KeyCommand}" CommandParameter="3" />
          <Button Focusable="False" Style="{StaticResource PadKey}" Content="4" Command="{Binding KeyCommand}" CommandParameter="4" />
          <Button Focusable="False" Style="{StaticResource PadKey}" Content="5" Command="{Binding KeyCommand}" CommandParameter="5" />
          <Button Focusable="False" Style="{StaticResource PadKey}" Content="6" Command="{Binding KeyCommand}" CommandParameter="6" />
          <Button Focusable="False" Style="{StaticResource PadKey}" Content="7" Command="{Binding KeyCommand}" CommandParameter="7" />
          <Button Focusable="False" Style="{StaticResource PadKey}" Content="8" Command="{Binding KeyCommand}" CommandParameter="8" />
          <Button Focusable="False" Style="{StaticResource PadKey}" Content="9" Command="{Binding KeyCommand}" CommandParameter="9" />
          <Button Focusable="False" Style="{StaticResource PadKey}" Content="." Command="{Binding KeyCommand}" CommandParameter="." />
          <Button Focusable="False" Style="{StaticResource PadKey}" Content="0" Command="{Binding KeyCommand}" CommandParameter="0" />
          <Button Focusable="False" Style="{StaticResource PadKey}" Content="&#xE750;" FontFamily="{StaticResource IconFont}" FontWeight="Normal"
                  Command="{Binding KeyCommand}" CommandParameter="⌫" />
        </UniformGrid>
        <Button Style="{StaticResource PrimaryButton}" Content="Open shift" Height="64" Margin="4,8,4,4" local:ButtonIcon.Glyph="&#xE785;"
                Command="{Binding OpenCommand}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>

<UserControl x:Class="TillPOS.App.Views.DownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Border Width="560" HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="28,24">
      <StackPanel>
        <!-- Header: spinning arc + title -->
        <DockPanel>
          <Grid DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,16,0" VerticalAlignment="Center">
            <Ellipse Stroke="{StaticResource Line}" StrokeThickness="4" />
            <Path Stroke="{StaticResource Accent}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  RenderTransformOrigin="0.5,0.5">
              <Path.Data>
                <!-- A quarter-less circle (270°) of radius 20 around (22,22). -->
                <PathGeometry>
                  <PathFigure StartPoint="22,2" IsClosed="False">
                    <ArcSegment Point="2,22" Size="20,20" IsLargeArc="True" SweepDirection="Clockwise" />
                  </PathFigure>
                </PathGeometry>
              </Path.Data>
              <Path.RenderTransform>
                <RotateTransform Angle="0" />
              </Path.RenderTransform>
              <Path.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                       From="0" To="360" Duration="0:0:1.1" RepeatBehavior="Forever" />
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </Path.Triggers>
            </Path>
          </Grid>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Ink}" />
            <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>

        <!-- Overall progress -->
        <ProgressBar Height="10" Margin="0,22,0,0" Minimum="0" Maximum="100"
                     Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                     Foreground="{StaticResource Accent}" Background="{StaticResource Line}" BorderThickness="0" />
        <DockPanel Margin="0,12,0,0">
          <TextBlock DockPanel.Dock="Right" VerticalAlignment="Bottom" Foreground="{StaticResource Muted}" Typography.NumeralAlignment="Tabular">
            <Run Text="{Binding StepText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Elapsed, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Text="{Binding CurrentText}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                     Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
        </DockPanel>

        <!-- Steps -->
        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,8,0,0">
          <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="·" />
                        <Setter Property="Foreground" Value="{StaticResource Muted}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding State}" Value="Running">
                            <Setter Property="Text" Value="●" />
                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            <DataTrigger.EnterActions>
                              <BeginStoryboard x:Name="Pulse">
                                <Storyboard>
                                  <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.6"
                                                   AutoReverse="True" RepeatBehavior="Forever" />
                                </Storyboard>
                              </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                              <StopStoryboard BeginStoryboardName="Pulse" />
                            </DataTrigger.ExitActions>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding State}" Value="Done">
                            <Setter Property="Text" Value="✓" />
                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding State}" Value="Failed">
                            <Setter Property="Text" Value="✕" />
                            <Setter Property="Foreground" Value="{StaticResource Danger}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Muted}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding State}" Value="Running">
                            <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding State}" Value="Done">
                            <Setter Property="Foreground" Value="{StaticResource Ink}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding State}" Value="Failed">
                            <Setter Property="Foreground" Value="{StaticResource Danger}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Grid.Column="2" Text="{Binding Detail}" HorizontalAlignment="Right" VerticalAlignment="Center"
                             TextAlignment="Right" TextWrapping="Wrap" Typography.NumeralAlignment="Tabular">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Muted}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding State}" Value="Failed">
                            <Setter Property="Foreground" Value="{StaticResource Danger}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <!-- Failed attempt: the problem and the countdown to the next one -->
        <Border Margin="0,16,0,0" Padding="14,10" CornerRadius="8" Background="#FBEDEB"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding RetryText}" Foreground="{StaticResource Muted}" Margin="0,4,0,0" Typography.NumeralAlignment="Tabular" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>

<UserControl x:Class="TillPOS.App.Views.UploadProblemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TillPOS.App">
  <!-- Upload problems (supervisor). A scan on this screen is ignored (MainWindow routes scans to the sale and returns only).
       Every action asks for a supervisor PIN; the buttons are not focusable, so Enter never presses one. -->
  <UserControl.Resources>
    <Style TargetType="Button" x:Key="RowButton" BasedOn="{StaticResource KeyButton}">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
    <DataTemplate x:Key="ProblemRow">
      <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding Kind}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Id}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Shift, StringFormat='Shift {0}'}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding Created}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
          <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0">
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{StaticResource Danger}" />
            <TextBlock Text="{Binding Attempts, StringFormat='Attempts: {0}'}" Foreground="{StaticResource Muted}" FontSize="12" />
          </StackPanel>
          <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource RowButton}" Content="View"
                    Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
            <Button Content="Retry" Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource RowButton}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsExcluded}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    <DataTrigger Binding="{Binding IsHandled}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Content="Include" Command="{Binding DataContext.IncludeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource RowButton}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsExcluded}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Content="Mark as handled" Command="{Binding DataContext.MarkHandledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource RowButton}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsHandled}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Content="Un-handle" Command="{Binding DataContext.UnhandleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource RowButton}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsHandled}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Warn}" Margin="0,0,10,0" />
        <TextBlock Text="Upload problems" Style="{StaticResource ScreenTitle}" />
      </StackPanel>
      <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                 Text="Failed: ERPNext refused the document, or its totals differ. Retry sends it again now; Mark as handled is for a document fixed by hand in ERPNext. Excluded: taken before this till went Live (test data), never uploaded unless included. Handled: dealt with by hand, never uploaded unless un-handled." />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel>
        <Border Style="{StaticResource Card}" Padding="16,8" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Failed" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding Failed}" ItemTemplate="{StaticResource ProblemRow}" Focusable="False" />
            <TextBlock Text="Nothing failed." Foreground="{StaticResource Muted}" Margin="0,6"
                       Visibility="{Binding Failed.Count, Converter={StaticResource EmptyToVisibility}}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="16,8">
          <StackPanel>
            <TextBlock Text="Excluded (before Live)" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding Excluded}" ItemTemplate="{StaticResource ProblemRow}" Focusable="False" />
            <TextBlock Text="Nothing excluded." Foreground="{StaticResource Muted}" Margin="0,6"
                       Visibility="{Binding Excluded.Count, Converter={StaticResource EmptyToVisibility}}" />
          </StackPanel>
        </Border>
        <!-- Dealt with by hand in ERPNext: final; the error column says who, when and why. -->
        <Border Style="{StaticResource Card}" Padding="16,8" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="Handled" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding Handled}" ItemTemplate="{StaticResource ProblemRow}" Focusable="False" />
            <TextBlock Text="Nothing handled by hand." Foreground="{StaticResource Muted}" Margin="0,6"
                       Visibility="{Binding Handled.Count, Converter={StaticResource EmptyToVisibility}}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="True">
      <Button DockPanel.Dock="Right" Style="{StaticResource KeyButton}" Focusable="False" Height="56" Width="200" local:ButtonIcon.Glyph="&#xE72B;"
              Content="Back" Command="{Binding BackCommand}" />
      <TextBlock Text="{Binding Message}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
    </DockPanel>
  </Grid>
</UserControl>

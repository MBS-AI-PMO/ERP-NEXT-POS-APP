<UserControl x:Class="TillPOS.App.Views.ReturnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TillPOS.App"
             xmlns:vm="clr-namespace:TillPOS.Presentation;assembly=TillPOS.Presentation"
             Focusable="True" FocusVisualStyle="{x:Null}">
  <!-- Enter confirms and Esc goes back; the receipt-number, scan and search boxes take their own Enter first.
       A scanner's Enter never gets here: the main window swallows it and hands the code to the view model. -->
  <UserControl.InputBindings>
    <KeyBinding Key="Enter" Command="{Binding ConfirmCommand}" />
    <KeyBinding Key="Escape" Command="{Binding BackCommand}" />
  </UserControl.InputBindings>
  <UserControl.Resources>
    <Style TargetType="TextBlock" x:Key="MessageText">
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MinHeight" Value="22" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding MessageIsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource Danger}" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TextBlock" x:Key="Head">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <Style TargetType="Button" x:Key="RowButton" BasedOn="{StaticResource KeyButton}">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="Height" Value="44" />
    </Style>
    <!-- Hidden on the find stage (the refund panel belongs to choosing and the return list). -->
    <Style TargetType="FrameworkElement" x:Key="NotOnFind">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsFind}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="380" /></Grid.ColumnDefinitions>

    <!-- ===== Title and message ===== -->
    <DockPanel Grid.Row="0" Grid.ColumnSpan="2">
      <TextBlock DockPanel.Dock="Right" Text="{Binding OriginalText}" FontFamily="Consolas" FontSize="16" VerticalAlignment="Center"
                 Foreground="{StaticResource Muted}" />
      <Grid>
        <TextBlock Text="Return — find the receipt" FontSize="24" FontWeight="Bold" Visibility="{Binding IsFind, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="Return — choose the items" FontSize="24" FontWeight="Bold" Visibility="{Binding IsChoose, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="Return without receipt" FontSize="24" FontWeight="Bold" Visibility="{Binding IsNoReceipt, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </DockPanel>
    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Message}" Style="{StaticResource MessageText}" Margin="0,4,0,8" />

    <!-- ===== Stage 1: find the receipt ===== -->
    <DockPanel x:Name="FindStage" Grid.Row="2" Grid.Column="0" Margin="0,0,16,0" Visibility="{Binding IsFind, Converter={StaticResource BoolToVisibility}}">
      <TextBlock DockPanel.Dock="Top" Text="Scan the barcode on the receipt, or type its number" Foreground="{StaticResource Muted}" />
      <DockPanel DockPanel.Dock="Top" Margin="0,4,0,0">
        <Button DockPanel.Dock="Right" Focusable="False" Style="{StaticResource PrimaryButton}" Width="150" Height="60" Margin="8,0,0,0"
                Content="Find (Enter)" FontSize="18" Command="{Binding FindCommand}" />
        <TextBox x:Name="FindBox" Height="60" FontSize="24" FontFamily="Consolas" VerticalContentAlignment="Center" Padding="8,0"
                 BorderBrush="{StaticResource Accent}" BorderThickness="2" local:Keyboarding.SelectAllOnTap="True"
                 Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="FindBoxKeyDown">
          <TextBox.InputBindings>
            <KeyBinding Key="Enter" Command="{Binding FindCommand}" />
          </TextBox.InputBindings>
        </TextBox>
      </DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="Recent bills on this till (tap one to open it)" FontWeight="SemiBold" Margin="0,12,0,4" />
      <ListBox x:Name="RecentList" ItemsSource="{Binding RecentBills}" HorizontalContentAlignment="Stretch" Background="{StaticResource Panel}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyDown="RecentListKeyDown" PreviewMouseLeftButtonUp="RecentListTapped">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Height="44">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="150" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding Time}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontFamily="Consolas" />
              <TextBlock Grid.Column="1" Text="{Binding ClientId}" VerticalAlignment="Center" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" Text="{Binding Total}" VerticalAlignment="Center" TextAlignment="Right" FontSize="17" Style="{StaticResource Money}" />
              <TextBlock Grid.Column="3" Text="{Binding Returned}" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource Warn}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Returned}" Value="all returned"><Setter Property="Foreground" Value="{StaticResource Muted}" /></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <ScrollViewer Grid.Row="2" Grid.Column="1" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Visibility="{Binding IsFind, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="16,12">
          <StackPanel>
            <TextBlock Text="No receipt?" FontWeight="Bold" FontSize="17" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,4,0,8"
                       Text="Lost receipt, or a bill from another till: scan the items into a return list. A supervisor must approve it, and the refund is at today's price." />
            <Button Focusable="False" Style="{StaticResource KeyButton}" Height="72" Command="{Binding NoReceiptCommand}">
              <TextBlock Text="Return without receipt (supervisor)" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
          </StackPanel>
        </Border>
        <Button Focusable="False" Style="{StaticResource KeyButton}" Height="56" Margin="4,12,4,4" Content="Back to the sale (Esc)" Command="{Binding BackCommand}" />
      </StackPanel>
    </ScrollViewer>

    <!-- ===== Stage 2: choose lines and quantities from the receipt ===== -->
    <DockPanel x:Name="ChooseStage" Grid.Row="2" Grid.Column="0" Margin="0,0,16,0" Visibility="{Binding IsChoose, Converter={StaticResource BoolToVisibility}}">
      <Grid DockPanel.Dock="Top" Margin="8,0,8,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="90" /><ColumnDefinition Width="100" />
          <ColumnDefinition Width="80" /><ColumnDefinition Width="200" /><ColumnDefinition Width="72" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="Item" Style="{StaticResource Head}" />
        <TextBlock Grid.Column="1" Text="Sold" Style="{StaticResource Head}" TextAlignment="Right" />
        <TextBlock Grid.Column="2" Text="Returned" Style="{StaticResource Head}" TextAlignment="Right" />
        <TextBlock Grid.Column="3" Text="Can return" Style="{StaticResource Head}" TextAlignment="Right" />
        <TextBlock Grid.Column="4" Text="Price" Style="{StaticResource Head}" TextAlignment="Right" />
        <TextBlock Grid.Column="5" Text="Return now" Style="{StaticResource Head}" TextAlignment="Center" />
      </Grid>
      <Button DockPanel.Dock="Bottom" Focusable="False" Style="{StaticResource KeyButton}" Height="52" HorizontalAlignment="Left" Width="220"
              Margin="0,8,0,0" Content="Return all" Command="{Binding ReturnAllCommand}" />
      <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="8,4">
        <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Height="52">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="90" /><ColumnDefinition Width="100" />
                    <ColumnDefinition Width="80" /><ColumnDefinition Width="200" /><ColumnDefinition Width="72" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding ItemName}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding SoldText}" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Money}" />
                  <TextBlock Grid.Column="2" Text="{Binding ReturnedText}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                             Style="{StaticResource Money}" />
                  <TextBlock Grid.Column="3" Text="{Binding ReturnableText}" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Money}" />
                  <TextBlock Grid.Column="4" Text="{Binding Rate}" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Money}" />
                  <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource RowButton}" Content="−" Command="{Binding DecrementCommand}" />
                    <TextBox Width="84" Height="40" FontSize="18" FontFamily="Consolas" TextAlignment="Right" VerticalContentAlignment="Center" Padding="4,0"
                             local:Keyboarding.SelectAllOnTap="True" Text="{Binding ReturnQty.Text, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Style="{StaticResource RowButton}" Content="+" Command="{Binding IncrementCommand}" />
                  </StackPanel>
                  <Button Grid.Column="6" Style="{StaticResource RowButton}" Content="All" FontSize="15" Command="{Binding AllCommand}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </DockPanel>

    <!-- ===== Stage 3: without receipt — scan or search the items into a return list ===== -->
    <DockPanel x:Name="NoReceiptStage" Grid.Row="2" Grid.Column="0" Margin="0,0,16,0" Visibility="{Binding IsNoReceipt, Converter={StaticResource BoolToVisibility}}">
      <TextBlock DockPanel.Dock="Top" Text="Scan the items being returned (refunded at today's price)" Foreground="{StaticResource Muted}" />
      <TextBox x:Name="ScanBox" DockPanel.Dock="Top" Height="56" FontSize="20" Margin="0,4,0,0" BorderBrush="{StaticResource Accent}" BorderThickness="2"
               Text="{Binding ScanText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="ScanBoxKeyDown">
        <TextBox.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding ScanEnteredCommand}" />
        </TextBox.InputBindings>
      </TextBox>
      <DockPanel DockPanel.Dock="Top" Margin="0,8,0,0">
        <TextBlock DockPanel.Dock="Left" Text="Search (F2):" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBox x:Name="SearchBox" Height="40" FontSize="16" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchBoxKeyDown" />
      </DockPanel>
      <ListBox DockPanel.Dock="Top" MaxHeight="160" Margin="0,4,0,0" ItemsSource="{Binding SearchResults}"
               Visibility="{Binding SearchResults.Count, Converter={StaticResource CountToVisibility}}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Button Focusable="False" Style="{StaticResource KeyButton}" HorizontalContentAlignment="Left" MinHeight="40"
                    Command="{Binding DataContext.AddFromSearchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding ItemCode}">
              <TextBlock><Run Text="{Binding ItemName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding ItemCode, Mode=OneWay}" Foreground="{StaticResource Muted}" /></TextBlock>
            </Button>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock DockPanel.Dock="Top" Text="Return list" FontWeight="SemiBold" Margin="0,8,0,4" />
      <ListBox ItemsSource="{Binding CartLines}" HorizontalContentAlignment="Stretch" Background="{StaticResource Panel}" Focusable="False"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem"><Setter Property="Focusable" Value="False" /></Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Height="52">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" />
                <ColumnDefinition Width="90" /><ColumnDefinition Width="100" /><ColumnDefinition Width="56" /><ColumnDefinition Width="56" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding No}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Barcode}" FontSize="12" Foreground="{StaticResource Muted}" FontFamily="Consolas" />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding Qty}" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Money}" />
              <TextBlock Grid.Column="3" Text="{Binding Price}" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Money}" />
              <TextBlock Grid.Column="4" Text="{Binding Amount}" TextAlignment="Right" VerticalAlignment="Center" FontSize="17" Style="{StaticResource Money}" />
              <Button Grid.Column="5" Style="{StaticResource RowButton}" Content="−"
                      Command="{Binding DataContext.DecrementCartLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" />
              <Button Grid.Column="6" Style="{StaticResource RowButton}" Foreground="{StaticResource Danger}" Content="✕"
                      Command="{Binding DataContext.RemoveCartLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- ===== Reason, refund and confirm (choose and without-receipt stages). Scrolls only if a small screen cannot fit it;
         every button is non-focusable so the keyboard stays in the boxes. ===== -->
    <ScrollViewer Grid.Row="2" Grid.Column="1" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Style="{StaticResource NotOnFind}">
      <StackPanel>
        <TextBlock Text="Reason (required)" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding Source={x:Static vm:ReturnViewModel.Reasons}}" Focusable="False">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Content="{Binding}" Command="{Binding DataContext.SetReasonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource KeyButton}">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="MinHeight" Value="48" />
                    <Setter Property="Height" Value="48" />
                    <Setter Property="FontSize" Value="15" />
                    <Style.Triggers>
                      <DataTrigger Value="True">
                        <DataTrigger.Binding>
                          <MultiBinding Converter="{StaticResource Equal}">
                            <Binding />
                            <Binding Path="DataContext.Reason" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                          </MultiBinding>
                        </DataTrigger.Binding>
                        <Setter Property="Background" Value="{StaticResource Accent}" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="FontWeight" Value="Bold" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Background="{StaticResource Ink}" CornerRadius="12" Padding="16,10" Margin="0,8,0,0">
          <StackPanel>
            <TextBlock Text="REFUND DUE — CASH (AED)" Foreground="#C9CFD6" />
            <TextBlock Text="{Binding RefundDueText}" Foreground="White" FontSize="40" MinHeight="48" Style="{StaticResource Money}" />
            <DockPanel>
              <TextBlock Text="Refund total" Foreground="#C9CFD6" />
              <TextBlock Text="{Binding RefundTotalText}" HorizontalAlignment="Right" Foreground="White" Style="{StaticResource Money}" />
            </DockPanel>
            <DockPanel>
              <TextBlock Text="VAT 5% (included)" Foreground="#C9CFD6" />
              <TextBlock Text="{Binding VatText}" HorizontalAlignment="Right" Foreground="White" Style="{StaticResource Money}" />
            </DockPanel>
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding NeedsText}" Foreground="{StaticResource Warn}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" />

        <Button Focusable="False" Style="{StaticResource PrimaryButton}" Height="72" Margin="4,8,4,4" Content="Confirm refund (Enter)"
                Command="{Binding ConfirmCommand}" />
        <Button Focusable="False" Style="{StaticResource KeyButton}" Height="52" Content="Back (Esc)" Command="{Binding BackCommand}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

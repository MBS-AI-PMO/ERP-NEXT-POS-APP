<UserControl x:Class="TillPOS.App.Views.LoginView" Focusable="True"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TillPOS.App">
  <UserControl.InputBindings>
    <KeyBinding Key="Enter" Command="{Binding LoginCommand}" />
    <KeyBinding Key="Back" Command="{Binding BackspaceCommand}" />
  </UserControl.InputBindings>
  <UserControl.Resources>
    <Style TargetType="Button" x:Key="PinKey" BasedOn="{StaticResource KeyButton}">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Height" Value="60" />
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Resources>
  <Grid>
    <Border Style="{StaticResource Card}" Width="420" Padding="24,22" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Accent}" Margin="0,0,10,0" />
          <TextBlock Text="Enter your PIN" FontSize="24" FontWeight="Bold" />
        </StackPanel>
        <!-- A shift is open on this till: logging in joins it at its counter ("Counter 2 · shift open since 08:00"). -->
        <Border Background="{StaticResource AccentSoft}" CornerRadius="{StaticResource Radius}" Padding="10,6" Margin="4,10,4,0"
                HorizontalAlignment="Center">
          <Border.Style>
            <Style TargetType="Border">
              <Style.Triggers>
                <DataTrigger Binding="{Binding ShiftInfo}" Value="">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource Accent}" Margin="0,0,8,0" />
            <TextBlock Text="{Binding ShiftInfo}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <Border Background="{StaticResource Ground}" CornerRadius="{StaticResource Radius}" Margin="4,12,4,8" Height="52">
          <TextBlock Text="{Binding PinMask}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="{Binding Message}" Foreground="{StaticResource Danger}" HorizontalAlignment="Center" TextWrapping="Wrap" MinHeight="22" />
        <UniformGrid Columns="3" Margin="0,4">
          <Button Focusable="False" Style="{StaticResource PinKey}" Content="1" Command="{Binding DigitCommand}" CommandParameter="1" />
          <Button Focusable="False" Style="{StaticResource PinKey}" Content="2" Command="{Binding DigitCommand}" CommandParameter="2" />
          <Button Focusable="False" Style="{StaticResource PinKey}" Content="3" Command="{Binding DigitCommand}" CommandParameter="3" />
          <Button Focusable="False" Style="{StaticResource PinKey}" Content="4" Command="{Binding DigitCommand}" CommandParameter="4" />
          <Button Focusable="False" Style="{StaticResource PinKey}" Content="5" Command="{Binding DigitCommand}" CommandParameter="5" />
          <Button Focusable="False" Style="{StaticResource PinKey}" Content="6" Command="{Binding DigitCommand}" CommandParameter="6" />
          <Button Focusable="False" Style="{StaticResource PinKey}" Content="7" Command="{Binding DigitCommand}" CommandParameter="7" />
          <Button Focusable="False" Style="{StaticResource PinKey}" Content="8" Command="{Binding DigitCommand}" CommandParameter="8" />
          <Button Focusable="False" Style="{StaticResource PinKey}" Content="9" Command="{Binding DigitCommand}" CommandParameter="9" />
          <Button Focusable="False" Style="{StaticResource PinKey}" Content="C" Foreground="{StaticResource Muted}" Command="{Binding ClearCommand}" />
          <Button Focusable="False" Style="{StaticResource PinKey}" Content="0" Command="{Binding DigitCommand}" CommandParameter="0" />
          <Button Focusable="False" Style="{StaticResource PinKey}" Content="&#xE750;" FontFamily="{StaticResource IconFont}" FontWeight="Normal"
                  Command="{Binding BackspaceCommand}" />
        </UniformGrid>
        <Button Style="{StaticResource PrimaryButton}" Content="Log in" Height="64" Margin="4,8,4,4" local:ButtonIcon.Glyph="&#xE8D7;"
                Command="{Binding LoginCommand}" />
        <!-- The build, so field feedback can name it (ShellViewModel.Version, the window's DataContext). -->
        <TextBlock Text="{Binding DataContext.Version, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='TillPOS {0}'}"
                   Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0" />
      </StackPanel>
    </Border>
    <!-- Supervisor only (asks for a supervisor PIN). Not focusable, so Enter and scanner keys never press it. -->
    <Button Style="{StaticResource SecondaryButton}" Content="Settings" Focusable="False" FontSize="14" MinHeight="48" local:ButtonIcon.Glyph="&#xE713;"
            HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="14,0" Command="{Binding SettingsCommand}" />
  </Grid>
</UserControl>

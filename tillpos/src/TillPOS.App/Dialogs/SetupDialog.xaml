<Window x:Class="TillPOS.App.Dialogs.SetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TillPOS.App"
        Title="TillPOS setup" Width="1080" SizeToContent="Height" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FontFamily="{StaticResource TextFont}" FontSize="16" Background="{StaticResource Ground}">
  <StackPanel Margin="20">
    <TextBlock Text="Till setup" FontSize="24" FontWeight="Bold" />
    <TextBlock Text="Choose the receipt printer, test it, set up the counters, then save." Foreground="{StaticResource Muted}" Margin="0,4,0,16" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="440" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="Receipt printer" FontWeight="SemiBold" />
        <ComboBox x:Name="PrinterBox" Height="40" Margin="0,6,0,14" VerticalContentAlignment="Center" />

        <TextBlock Text="Paper width" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Margin="0,6,0,14">
          <RadioButton x:Name="Paper80" Content="80 mm" GroupName="Paper" Margin="0,0,24,0" VerticalContentAlignment="Center" />
          <RadioButton x:Name="Paper58" Content="58 mm" GroupName="Paper" VerticalContentAlignment="Center" />
        </StackPanel>

        <TextBlock Text="Till number (1–99)" FontWeight="SemiBold" />
        <TextBox x:Name="TillBox" Width="100" Height="40" HorizontalAlignment="Left" MaxLength="2" Margin="0,6,0,14"
                 VerticalContentAlignment="Center" FontSize="18" />

        <CheckBox x:Name="PreviewBox" Content="Show invoice on screen after each sale" VerticalContentAlignment="Center" Margin="0,0,0,16" />

        <!-- Upload mode: only Live writes to ERPNext. Changing it is logged with the supervisor who opened Settings. -->
        <StackPanel x:Name="UploadPanel" Margin="0,0,0,16">
          <TextBlock Text="Upload to ERPNext" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
            <RadioButton x:Name="UploadOff" Content="Off" GroupName="Upload" Margin="0,0,24,0" VerticalContentAlignment="Center" />
            <RadioButton x:Name="UploadDryRun" Content="Dry run" GroupName="Upload" Margin="0,0,24,0" VerticalContentAlignment="Center" />
            <RadioButton x:Name="UploadLive" Content="Live" GroupName="Upload" VerticalContentAlignment="Center"
                         Foreground="{StaticResource Danger}" FontWeight="SemiBold" />
          </StackPanel>
          <TextBlock Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap"
                     Text="Off: bills stay on the till. Dry run: bills are checked and saved as files, nothing is sent. Live: bills, shifts and approvals are sent to ERPNext." />
        </StackPanel>

        <Button x:Name="TestButton" Style="{StaticResource KeyButton}" Content="Test print" Width="160" HorizontalAlignment="Left"
                Margin="0" Click="TestPrintClick" />
      </StackPanel>

      <!-- Counters: one row per ERPNext POS Profile the cashiers can open a shift at. The first row is the default. -->
      <StackPanel Grid.Column="2">
        <TextBlock Text="Counters" FontWeight="SemiBold" />
        <TextBlock Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,8"
                   Text="One row per counter: its POS Profile in ERPNext, a short name for the screen and receipts, and its cash and card payment modes. The first row is the default. Cashiers choose the counter when they open a shift." />
        <Grid Margin="0,0,44,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="2*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="POS Profile" FontSize="13" Foreground="{StaticResource Muted}" Margin="2,0" />
          <TextBlock Grid.Column="1" Text="Name shown" FontSize="13" Foreground="{StaticResource Muted}" Margin="2,0" />
          <TextBlock Grid.Column="2" Text="Cash mode" FontSize="13" Foreground="{StaticResource Muted}" Margin="2,0" />
          <TextBlock Grid.Column="3" Text="Card mode" FontSize="13" Foreground="{StaticResource Muted}" Margin="2,0" />
        </Grid>
        <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" Focusable="False">
          <ItemsControl x:Name="CounterRows" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="44" />
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" Height="38" FontSize="14" Margin="2,0" local:Placeholder.Text="Al Ain Counter 1" local:Placeholder.FontSize="13"
                           Text="{Binding PosProfile, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBox Grid.Column="1" Height="38" FontSize="14" Margin="2,0" local:Placeholder.Text="Counter 1" local:Placeholder.FontSize="13"
                           Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBox Grid.Column="2" Height="38" FontSize="14" Margin="2,0" local:Placeholder.Text="Cash Counter 1" local:Placeholder.FontSize="13"
                           Text="{Binding CashMode, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBox Grid.Column="3" Height="38" FontSize="14" Margin="2,0" local:Placeholder.Text="Credit Card" local:Placeholder.FontSize="13"
                           Text="{Binding CardMode, UpdateSourceTrigger=PropertyChanged}" />
                  <Button Grid.Column="4" Style="{StaticResource DangerIconButton}" Content="&#xE74D;" ToolTip="Remove this counter"
                          MinHeight="38" MinWidth="38" Margin="4,0,0,0" Focusable="False" Click="RemoveCounterClick" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Button Style="{StaticResource SecondaryButton}" Content="Add counter" local:ButtonIcon.Glyph="&#xE710;" HorizontalAlignment="Left"
                Padding="14,0" Margin="0,4,0,0" Focusable="False" Click="AddCounterClick" />
      </StackPanel>
    </Grid>

    <TextBlock x:Name="StatusText" TextWrapping="Wrap" MinHeight="24" Margin="0,12,0,8" FontWeight="SemiBold" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Style="{StaticResource KeyButton}" Content="Cancel" Width="120" IsCancel="True" />
      <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="Save and start" Width="220" Click="SaveClick" />
    </StackPanel>
  </StackPanel>
</Window>

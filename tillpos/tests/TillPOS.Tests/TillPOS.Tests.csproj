<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TillPOS.Core\TillPOS.Core.csproj" />
    <ProjectReference Include="..\..\src\TillPOS.Data\TillPOS.Data.csproj" />
    <ProjectReference Include="..\..\src\TillPOS.Erp\TillPOS.Erp.csproj" />
    <ProjectReference Include="..\..\src\TillPOS.Sync\TillPOS.Sync.csproj" />
    <ProjectReference Include="..\..\src\TillPOS.Printing\TillPOS.Printing.csproj" />
    <ProjectReference Include="..\..\src\TillPOS.Presentation\TillPOS.Presentation.csproj" />
  </ItemGroup>

  <!-- The app is net10.0-windows (WPF) and cannot be referenced here; its settings code is plain .NET (DPAPI stays in the
       app's SettingsStore.Windows.cs), so those two files are compiled into the tests directly. -->
  <ItemGroup>
    <Compile Include="..\..\src\TillPOS.App\TillSettings.cs" Link="App\Linked\TillSettings.cs" />
    <Compile Include="..\..\src\TillPOS.App\SettingsStore.cs" Link="App\Linked\SettingsStore.cs" />
  </ItemGroup>

</Project>